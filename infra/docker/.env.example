# Environment for the local Docker Compose stack.
#
# `make up` copies this to `infra/docker/.env` if that file does not exist.
# Compose reads it automatically because it sits next to `compose.yml`.
#
# This is deliberately separate from the repository-root `.env.example`, which
# targets processes running on the host and therefore points at `localhost`.
# Inside a container `localhost` is the container itself, so those values would
# not reach Postgres. Every service URL already defaults to the `postgres`
# service name in `compose.yml`; leave them unset here to keep those defaults.

# =============================================================================
# Local testing (the defaults below) — unauthenticated, localhost only
# =============================================================================

# Compose fails fast rather than defaulting this, so that no deployment ever
# starts without auth by accident.
AUTH_MODE=none

# Explicit opt-in required to run AUTH_MODE=none inside a container. The image
# is a production build binding 0.0.0.0, which the startup guard rejects by
# default; neither check can see whether the port is actually published, so
# this flag makes "I know this is unauthenticated" deliberate and greppable.
#
# It does NOT waive the CORS_ORIGIN check below, so it cannot be used to serve
# an unauthenticated app on a public domain. Remove it for any real deployment.
ALLOW_INSECURE_NO_AUTH=true

# The origin you open in the browser. Must be a local http origin while
# AUTH_MODE=none; set it to your real https origin for a deployment.
CORS_ORIGIN=http://localhost:3000

# --- Optional ---

# Web AI chat at /chat. Leave empty to run the stack without it.
OPENAI_API_KEY=

# Langfuse tracing. Set the three connection values together to enable it;
# LANGFUSE_RELEASE alone does not. See docs/langfuse-operations.md.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_RELEASE=

# =============================================================================
# Self-hosted deployment behind Cloudflare Access
#
# Full walkthrough: docs/self-hosting.md
# =============================================================================
#
# AUTH_MODE=cloudflare_access
# ALLOW_INSECURE_NO_AUTH=      # must be empty
#
# The origin the BROWSER uses, not the address the container binds to. It is
# compared against the Origin header on every mutating request, and must be
# https because the __Host-csrf cookie is issued Secure.
# CORS_ORIGIN=https://money.example.com
#
# COOKIE_DOMAIN is not needed in this mode — it only scopes the Cognito
# session cookies. Cloudflare owns the session here.
#
# Cloudflare Zero Trust → Settings → Custom Pages shows the team domain;
# the audience tag is on the Access application's Overview tab.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=<64-character application audience tag>

# =============================================================================
# AWS Cognito (the upstream hosted deployment)
# =============================================================================
#
# AUTH_MODE=cognito
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=
# SESSION_ENCRYPTION_KEY=      # openssl rand -hex 32
#
# The auth service is only started with the cognito profile:
#   docker compose -f infra/docker/compose.yml --profile cognito up -d
